# Copie para .env e preencha.

NODE_ENV=development
PORT=4000

# MongoDB Atlas (recomendado) ou local:
# mongodb://127.0.0.1:27017/rigatti
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/rigatti?retryWrites=true&w=majority

# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-de-32-chars
JWT_EXPIRES_IN=8h

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# Origens do frontend separadas por vírgula (use * apenas em dev)
CORS_ORIGIN=http://localhost:5173

MAX_UPLOAD_BYTES=2097152
